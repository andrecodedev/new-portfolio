# Supabase (Auth + cms_content + storage).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (anti-bot no login). Site key pública.
# No Supabase: Authentication → Attack Protection → Enable CAPTCHA (Turnstile)
# e cole a secret key lá.
VITE_TURNSTILE_SITE_KEY=
